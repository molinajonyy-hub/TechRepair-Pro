{
  "manifest_version": 3,
  "name": "TechRepair Companion",
  "version": "1.0.0",
  "description": "Abre o reutiliza una pestaña de WhatsApp Web desde TechRepair Pro. Vos revisás el mensaje y apretás Enviar.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://techrepairpro.app/*",
      "https://www.techrepairpro.app/*"
    ]
  }
}
