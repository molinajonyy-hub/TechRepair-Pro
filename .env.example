VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Analítica de la landing — TODAS opcionales. La app funciona sin ellas (no-op).
# Los scripts se cargan desde el código (src/lib/analytics.ts), NO pegar snippets
# manualmente en index.html. No commitear IDs/datos reales: cargarlos en Vercel.
#
# Google Analytics 4 (gtag.js). Formato G-XXXXXXXXXX. Si falta o es inválido, no
# se carga gtag.js y los eventos internos siguen funcionando.
VITE_GA_MEASUREMENT_ID=
# Microsoft Clarity: si se define, la landing carga Clarity con este project id.
VITE_CLARITY_PROJECT_ID=

# Canal de SOPORTE del producto (BETA-UX-1A). Es el WhatsApp que abren Ayuda, la
# pantalla global de error, el muro de fin de prueba, las pantallas previas al
# negocio y el pie de la landing. Lo lee un solo archivo: src/config/contacto.ts.
#
# Formato: celular argentino para wa.me, 13 dígitos = 54 + 9 + número nacional
# de 10. Ej.: 549351XXXXXXX. NO es opcional en producción:
#   · con un valor inválido (594…, sin el 9, truncado, con letras) `vite build` FALLA;
#   · vacío, el build falla en Vercel Production y sólo avisa en local/CI/Preview
#     (la app muestra «la ayuda no está disponible», nunca un correo).
# Para probar un valor antes de cargarlo en Vercel:
#   VITE_CONTACT_WHATSAPP=549… npm run guard:support-contact -- --production
#
# OJO: los correos de Supabase Auth (supabase/templates/*.html) NO leen esta
# variable. Llevan el mismo número escrito, como dato público versionado. Si el
# número cambia hay que cambiarlo también en las dos plantillas y en
# scripts/guards/auth-email-templates.mjs, y volver a pegarlas en Supabase Auth.
VITE_CONTACT_WHATSAPP=

# Contacto público de la landing (opcional).
# Si una variable queda vacía, el enlace NO se renderiza (evita contactos ficticios).
#   Email: contacto institucional del pie; por defecto, el de la política de privacidad
#   Instagram: usuario sin @
VITE_CONTACT_EMAIL=
VITE_CONTACT_INSTAGRAM=

# TechRepair WhatsApp Companion — extensión de Chrome (tools/whatsapp-companion).
# Las dos son OPCIONALES y el frontend falla CERRADO sin ellas: si no hay ID, el
# preview se comporta como si el Companion no estuviera instalado y ofrece los
# fallbacks (app de escritorio / pestaña nueva / copiar).
#
# ID de la extensión PUBLICADA: 32 caracteres a-p. El id del unpacked de
# desarrollo NO sirve acá — cambia según la carpeta y no es el de producción.
VITE_WHATSAPP_COMPANION_EXTENSION_ID=
# URL de instalación (https). Mientras la extensión no esté publicada, dejar
# vacío: sin URL la UI no ofrece instalar, en vez de mandar a un link inventado.
VITE_WHATSAPP_COMPANION_INSTALL_URL=
